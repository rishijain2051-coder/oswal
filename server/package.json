{
  "name": "@oswal/server",
  "version": "0.1.0",
  "private": true,
  "description": "Oswal Handicrafts ERP backend (Express + Prisma + Postgres)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "pg": "tsx scripts/pg.ts",
    "pg:start": "tsx scripts/pg.ts start",
    "pg:stop": "tsx scripts/pg.ts stop",
    "pg:restart": "tsx scripts/pg.ts restart",
    "pg:status": "tsx scripts/pg.ts status",
    "pg:reset": "tsx scripts/pg.ts reset",
    "db:backup": "tsx scripts/backup.ts backup",
    "db:backups": "tsx scripts/backup.ts list",
    "db:restore": "tsx scripts/backup.ts restore",
    "prisma:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "tsx scripts/pg.ts start && prisma db push && tsx prisma/seed.ts",
    "db:reset": "tsx scripts/pg.ts start && prisma db push --force-reset && tsx prisma/seed.ts",
    "db:demo": "tsx scripts/pg.ts start && tsx prisma/demoSeed.ts",
    "db:fill": "tsx scripts/pg.ts start && tsx prisma/demoSeed.ts",
    "db:clean": "tsx scripts/pg.ts start && tsx prisma/cleanSlate.ts",
    "verify": "tsx prisma/verify.ts",
    "db:studio": "tsx scripts/pg.ts start && prisma studio",
    "db:workers": "tsx scripts/pg.ts start && tsx prisma/migrateWorkers.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.3.1",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nanoid": "^3.3.8",
    "pdfkit": "^0.19.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.5",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.20.0",
    "embedded-postgres": "17.10.0-beta.17",
    "pg": "^8.22.0",
    "prisma": "^6.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
