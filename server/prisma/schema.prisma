// Oswal Handicrafts ERP — Prisma schema
//
// Provider is Postgres. In development it is a cluster that lives inside the repo
// (`server/.pgdata`, managed by `scripts/pg.ts` — see `npm run pg:start`); in production
// it is a hosted database, and only DATABASE_URL differs between the two.
//
// The models stayed portable across the move off SQLite and are worth keeping that way:
// enum-like fields are `String` validated with zod in the routes, money is `Float`
// rounded at the API boundary, and no column uses a native database type.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Users & access
// ---------------------------------------------------------------------------

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // What this account may do. NULL means no role and therefore NO permissions — a
  // deliberate default: a new login can sign in and see nothing until somebody grants it
  // something, rather than inheriting a rank nobody chose.
  roleId Int?
  role   Role? @relation(fields: [roleId], references: [id])

  // The key under the mat. An owner holds every permission in the catalogue regardless of
  // their role, and sits OUTSIDE the role system on purpose: permissions are resolved from
  // the database on every request, so a role that lost `roles.manage` would otherwise be
  // unrecoverable without direct database surgery. The last active owner cannot be
  // deactivated, deleted, or demoted — see `guardLastOwner` in users.routes.ts.
  isOwner Boolean @default(false)

  productsCreated Product[] @relation("ProductCreatedBy")
}

/// A named set of permissions. Wholly user-defined — the app ships none, and there is no
/// built-in rank behind them. `isActive` follows the master-data convention rather than
/// `deletedAt`; a role is configuration, not a record of something that happened.
model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String   @default("")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  users       User[]
}

/// One granted permission key. The KEY IS NOT VALIDATED BY THE DATABASE — it is checked
/// against the catalogue in `lib/permissions.ts` on the way in, because that file is the
/// single authority for which permissions exist and a foreign key to a table of them would
/// be a second one. `verify.ts` asserts the catalogue and the routes agree.
model RolePermission {
  id     Int    @id @default(autoincrement())
  roleId Int
  key    String

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, key])
  @@index([roleId])
}

// ---------------------------------------------------------------------------
// Master data
// ---------------------------------------------------------------------------

model Currency {
  id         Int      @id @default(autoincrement())
  code       String   @unique // INR, USD, EUR
  name       String
  symbol     String   @default("")
  // 1 unit of THIS currency = rateToBase units of the base currency (INR).
  rateToBase Float    @default(1)
  isBase     Boolean  @default(false)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  costSheets CostSheet[]
  orders     Order[]
  proformas  Proforma[]
  invoices   Invoice[]
  buyers     Buyer[]
}

model Unit {
  id        Int     @id @default(autoincrement())
  code      String  @unique // PCS, SET, KGS, CFT, SQFT, SQM, MTR, LTR
  name      String
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  products Product[]
}

/// Generic managed list powering product classification + filters.
/// `type` groups values: PRODUCT_TYPE | SIZE | COLOUR | MATERIAL | FINISH | ITEM_TYPE
model AttributeValue {
  id        Int      @id @default(autoincrement())
  type      String
  value     String
  code      String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  productsItemType Product[] @relation("ProductItemType")
  productsType     Product[] @relation("ProductType")
  productsSize     Product[] @relation("ProductSize")
  productsColour   Product[] @relation("ProductColour")
  productsMaterial Product[] @relation("ProductMaterial")
  productsFinish   Product[] @relation("ProductFinish")

  @@unique([type, value])
}

model Buyer {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  name        String
  country     String?
  contactName String?
  email       String?
  phone       String?
  address     String?
  isActive    Boolean  @default(true)

  /// Who they are: B2B (trade) or B2C (end customer). Independent of `market`, so all
  /// four combinations exist — an overseas importer, a domestic dealer, a walk-in, a
  /// web order from abroad.
  channel String @default("B2B") // B2B | B2C
  /// Where they are: OVERSEAS sells at FOB in their currency and is zero-rated;
  /// DOMESTIC sells at Non-FOB in rupees and carries GST.
  market  String @default("OVERSEAS") // OVERSEAS | DOMESTIC

  /// GSTIN. Required in practice for a domestic B2B buyer, absent for B2C, and
  /// meaningless overseas.
  gstNo String?
  /// The buyer's state, which decides CGST+SGST versus IGST against the company's own.
  state String?

  /// What this buyer is normally quoted in, and on what terms.
  ///
  /// Defaults for a new proforma, nothing more — every document snapshots its own currency and
  /// terms, so changing these never rewrites one that already exists. They are here because a
  /// buyer IS their currency in practice: a UK account is quoted in sterling every time, and
  /// the proforma form used to open on whichever currency happened to be first in the list.
  /// Getting that wrong books the order at the wrong exchange rate as well as the wrong price.
  currencyId    Int?
  paymentTerms  String?
  deliveryTerms String?
  incoterms     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  currency  Currency?      @relation(fields: [currencyId], references: [id])
  products  ProductBuyer[]
  orders    Order[]
  proformas Proforma[]
  ledger    LedgerEntry[]  @relation("BuyerLedger")
  invoices  Invoice[]
}

// ---------------------------------------------------------------------------
// Product
// ---------------------------------------------------------------------------

model Product {
  id          Int     @id @default(autoincrement())
  factoryCode String  @unique
  name        String // item description / name
  alias       String?
  status      String  @default("Draft") // Draft | Active | Discontinued
  description String?
  notes       String?

  // classification (master-list relations)
  itemTypeId    Int?
  productTypeId Int?
  sizeId        Int?
  colourId      Int?
  materialId    Int?
  finishId      Int?
  unitId        Int?

  // production routing — which stage line this product travels through
  stageLineId Int?

  // physical — assembled product (inches)
  prodLengthIn  Float?
  prodWidthIn   Float?
  prodHeightIn  Float?
  netWeightKg   Float?
  grossWeightKg Float?

  // physical — packed / carton (inches)
  packLengthIn    Float?
  packWidthIn     Float?
  packHeightIn    Float?
  piecesPerCarton Int?

  // differentiated volumes (CBM) — before vs after packing
  volumeBeforePackingCbm Float?
  volumeAfterPackingCbm  Float?

  /// Tax classification for domestic sales. Seeds the rate on a domestic proforma or
  /// order line, which can then override it. Exports are zero-rated, so neither field
  /// has any effect on an overseas document.
  hsnCode    String?
  gstRatePct Float   @default(18)

  createdById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// Soft delete. Set instead of removing the row, so nothing is ever unrecoverable.
  /// EVERY query that feeds a list or the money engine must filter `deletedAt: null` —
  /// see lib/softDelete.ts. Filtering happens at the query layer, never inside the pure
  /// functions, exactly as a cancelled order is excluded.
  deletedAt DateTime?

  itemType    AttributeValue? @relation("ProductItemType", fields: [itemTypeId], references: [id])
  productType AttributeValue? @relation("ProductType", fields: [productTypeId], references: [id])
  size        AttributeValue? @relation("ProductSize", fields: [sizeId], references: [id])
  colour      AttributeValue? @relation("ProductColour", fields: [colourId], references: [id])
  material    AttributeValue? @relation("ProductMaterial", fields: [materialId], references: [id])
  finish      AttributeValue? @relation("ProductFinish", fields: [finishId], references: [id])
  unit        Unit?           @relation(fields: [unitId], references: [id])
  stageLine   StageLine?      @relation(fields: [stageLineId], references: [id])
  createdBy   User?           @relation("ProductCreatedBy", fields: [createdById], references: [id])

  buyers      ProductBuyer[]
  costSheets  CostSheet[]
  images      ProductImage[]
  relatedFrom RelatedProduct[] @relation("RelatedFrom")
  relatedTo   RelatedProduct[] @relation("RelatedTo")

  orderLines      OrderLine[]
  proformaLines   ProformaLine[]
  operationSheets OperationSheet[]

  finishedTxns  FinishedTxn[]
  packingBatches PackingBatch[]
  invoiceLines  InvoiceLine[]
  /// Raw-item rows that are this product bought in finished — see RawItem.productId.
  boughtInAs    RawItem[]

  @@index([productTypeId])
  @@index([status])
  @@index([deletedAt])
}

model ProductBuyer {
  id        Int     @id @default(autoincrement())
  productId Int
  buyerId   Int
  buyerCode String? // buyer's own article/style code for THIS product

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  buyer   Buyer   @relation(fields: [buyerId], references: [id], onDelete: Cascade)

  @@unique([productId, buyerId])
}

model RelatedProduct {
  id        Int     @id @default(autoincrement())
  productId Int
  relatedId Int
  relation  String // VARIANT | PART | ACCESSORY | SET
  note      String?

  product Product @relation("RelatedFrom", fields: [productId], references: [id], onDelete: Cascade)
  related Product @relation("RelatedTo", fields: [relatedId], references: [id], onDelete: Cascade)

  @@unique([productId, relatedId, relation])
}

model ProductImage {
  id           Int      @id @default(autoincrement())
  productId    Int
  filename     String
  originalName String?
  url          String
  isPrimary    Boolean  @default(false)
  caption      String?
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  product       Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  proformaLines ProformaLine[] @relation("ProformaLineImage")
}

// ---------------------------------------------------------------------------
// Costing engine
//   CostSheet -> CostGroup (material group, defines measurement method)
//             -> CostLine  (individual part / item)
// Measures (CFT/SQFT/...) and amounts are COMPUTED by the API, not stored,
// to avoid drift.
// ---------------------------------------------------------------------------

model CostSheet {
  id                Int      @id @default(autoincrement())
  productId         Int
  version           Int      @default(1)
  name              String?  @default("Costing")
  isActive          Boolean  @default(true)
  currencyId        Int?
  factoryExpensePct Float    @default(15)
  marginPct         Float    @default(15)
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  product  Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  currency Currency?   @relation(fields: [currencyId], references: [id])
  groups   CostGroup[]

  @@unique([productId, version])
}

/// A costing measurement method with a user-editable formula.
/// Variables available to `expression`: L, W, H (costing dims), AL, AW, AH
/// (actual dims), QTY, WASTAGE, WEIGHT. Measure = expression; amount = measure × rate.
model CostMethod {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  label       String
  measureUnit String   @default("UNIT")
  expression  String   @default("QTY")
  usesL       Boolean  @default(false)
  usesW       Boolean  @default(false)
  usesH       Boolean  @default(false)
  usesWeight  Boolean  @default(false)
  usesWastage Boolean  @default(true)
  dimUnit     String? // IN | CM
  isBuiltIn   Boolean  @default(false)
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CostGroup {
  id          Int     @id @default(autoincrement())
  costSheetId Int
  head        String // MAIN_COMPONENT | SUB_COMPONENT | HARDWARE | POLISHING | PACKAGING | LABOUR | FORWARDING
  name        String // e.g. "Mango Wood", "Iron", "Ply 6mm"
  method      String // CFT | SQFT | SQMT | WEIGHT | QTY | RFT
  dimUnit     String? // input dim unit hint for area/volume methods: IN | CM
  sortOrder   Int     @default(0)
  notes       String?

  costSheet CostSheet  @relation(fields: [costSheetId], references: [id], onDelete: Cascade)
  lines     CostLine[]
}

model CostLine {
  id         Int    @id @default(autoincrement())
  groupId    Int
  name       String
  qty        Float  @default(1)
  wastagePct Float  @default(0)

  // actual dimensions (as measured)
  actualL Float?
  actualW Float?
  actualH Float?

  // costing dimensions (drive the measure; auto-suggested from actual+wastage, editable)
  costL Float?
  costW Float?
  costH Float?

  // weight method
  actualWeight Float?

  unit      String? // display unit for this line
  rate      Float   @default(0) // cost per measure unit (per CFT / SQFT / kg / piece ...)
  sortOrder Int     @default(0)

  /// Which production stage this line pays for. Only meaningful on LABOUR lines, and
  /// purely a REFERENCE: it defaults the in-house piece rate when an order snapshots
  /// its stages, but the rate that actually pays sits on OrderLineStage.labourRate.
  /// Costing itself never reads this — the roll-up is unchanged.
  stageStepId Int?

  group     CostGroup      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  stageStep StageLineStep? @relation(fields: [stageStepId], references: [id])
}

// ---------------------------------------------------------------------------
// Operations module (Phase 2) — proformas, orders, the production board,
// challans, suppliers, stock, material sheets, payments.
// ---------------------------------------------------------------------------

model Supplier {
  id           Int      @id @default(autoincrement())
  code         String   @unique
  name         String
  type         String   @default("MATERIAL") // MATERIAL | JOBWORK | BOTH
  contactName  String?
  email        String?
  phone        String?
  gstNo        String?
  address      String?
  paymentTerms String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  stockTxns  StockTxn[]
  lineStages OrderLineStage[] @relation("StageVendor")
  ledger     LedgerEntry[]    @relation("SupplierLedger")
}

model RawItem {
  id           Int      @id @default(autoincrement())
  code         String   @unique
  name         String
  category     String?
  unit         String   @default("PCS")
  reorderLevel Float    @default(0)
  openingQty   Float    @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  /// Set when this purchased item IS a finished product, bought in rather than made —
  /// a trading line the factory resells without producing.
  ///
  /// The link lives HERE, not on `StockTxn`, on purpose. A receipt against a product
  /// would mean making `StockTxn.rawItemId` nullable, and every reader dereferences
  /// `txn.rawItem` without a null check. This way the whole supplier machinery is
  /// untouched — the receipt, the `stockTxnId @unique` billed-once rule, the supplier
  /// statement and the un-billed-deliveries surface all keep working — and finished
  /// stock simply counts `StockTxn` rows whose item points at a product.
  productId Int?

  product Product?   @relation(fields: [productId], references: [id])
  txns    StockTxn[]

  @@index([productId])
}

model StockTxn {
  id          Int      @id @default(autoincrement())
  rawItemId   Int
  type        String // IN | OUT
  qty         Float
  rate        Float    @default(0) // cost per unit (IN valuation)
  supplierId  Int?
  orderRef    String? // optional reference to an order number (for OUT)
  note        String?
  date        DateTime @default(now())
  createdById Int?
  createdAt   DateTime @default(now())

  rawItem  RawItem      @relation(fields: [rawItemId], references: [id], onDelete: Cascade)
  supplier Supplier?    @relation(fields: [supplierId], references: [id])
  /// The bill raised for this receipt, if one has been. Lets a supplier statement
  /// show which deliveries are still un-billed without ever double-counting them.
  bill     LedgerEntry?
}

// ---------------------------------------------------------------------------
// Production routing
// ---------------------------------------------------------------------------

/// A named production route ("stage line"), e.g.
///   X — raw joining → raw sanding → polishing → accessory fitting → QC → packaging
///   Y — raw joining → powder coating → fitting → QC → packing
/// A product is assigned one stage line. Each order line SNAPSHOTS the steps into
/// OrderLineStage rows, so editing the master later never rewrites live orders.
model StageLine {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  steps      StageLineStep[]
  products   Product[]
  orderLines OrderLine[]
}

model StageLineStep {
  id          Int    @id @default(autoincrement())
  stageLineId Int
  name        String
  sortOrder   Int    @default(0)

  /// How long this step usually takes. Used to auto-schedule an order backwards from
  /// its delivery date; steps left null fall back to an equal share of what is left.
  /// Stating it once here is what makes a generated schedule believable.
  defaultDays Int?

  stageLine StageLine  @relation(fields: [stageLineId], references: [id], onDelete: Cascade)
  costLines CostLine[]
}

// ---------------------------------------------------------------------------
// Orders + the production board
// ---------------------------------------------------------------------------

model Order {
  id           Int       @id @default(autoincrement())
  number       String    @unique
  buyerId      Int
  currencyId   Int?
  status       String    @default("Confirmed") // Confirmed|Production|Ready|Shipped|Closed|Cancelled
  orderDate    DateTime  @default(now())
  deliveryDate DateTime?
  incoterms    String?
  exchangeRate Float? // buyer currency rateToBase snapshot
  notes        String?
  proformaId   Int?      @unique
  createdById  Int?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  /// The factory's own estimate of when this will actually ship. Distinct from
  /// `deliveryDate`, which is what the buyer asked for — comparing the two is the
  /// whole point of delivery tracking.
  expectedDelivery DateTime?

  /// The tax basis, SNAPSHOTTED when the document is created — the same discipline as
  /// `exchangeRate` and the stage steps. Read live, a later correction to the buyer's
  /// market or state would silently restate every document already issued: a GST
  /// quotation would reprint as an untaxed export, and receivables would move.
  taxMarket       String?
  taxBuyerState   String?
  taxCompanyState String?

  /// Soft delete. Set instead of removing the row, so nothing is ever unrecoverable.
  /// EVERY query that feeds a list or the money engine must filter `deletedAt: null` —
  /// see lib/softDelete.ts. Filtering happens at the query layer, never inside the pure
  /// functions, exactly as a cancelled order is excluded.
  deletedAt DateTime?

  buyer    Buyer            @relation(fields: [buyerId], references: [id])
  currency Currency?        @relation(fields: [currencyId], references: [id])
  proforma Proforma?        @relation("ProformaOrder", fields: [proformaId], references: [id])
  lines       OrderLine[]
  charges     OrderCharge[]
  attachments OrderAttachment[]
  schedules   OrderLineSchedule[]
  sheets      OperationSheet[]
  ledger      LedgerEntry[]

  @@index([deletedAt])
}

/// A file hanging off an order: the buyer's PO, a bill of lading, customs paperwork, a
/// packing list, an inspection certificate. Validated by extension AND magic bytes in
/// lib/documentUpload.ts — a declared mimetype is attacker-controlled and proves nothing,
/// exactly as for product images.
model OrderAttachment {
  id           Int      @id @default(autoincrement())
  orderId      Int
  filename     String
  originalName String?
  url          String
  /// PO_COPY | SHIPPING | CUSTOMS | PACKING_LIST | INSPECTION | OTHER
  label        String?
  note         String?
  sizeBytes    Int?
  uploadedById Int?
  createdAt    DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

/// The accepted proforma's charges, copied onto the order so the order is worth exactly
/// what was quoted. Same shape and same maths as ProformaCharge.
model OrderCharge {
  id         Int     @id @default(autoincrement())
  orderId    Int
  name       String
  kind       String  @default("CHARGE") // CHARGE | DISCOUNT
  amount     Float   @default(0)
  pct        Float   @default(0)
  gstRatePct Float   @default(0)
  isTaxable  Boolean @default(true)
  note       String?
  sortOrder  Int     @default(0)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model OrderLine {
  id        Int   @id @default(autoincrement())
  orderId   Int
  productId Int
  qty       Int   @default(1)
  unitPrice Float @default(0) // in order currency
  sortOrder Int   @default(0)

  /// Carried over from the proforma that was accepted, so the order is worth exactly
  /// what was quoted. Same maths as ProformaLine — `lineNet()` in lib/pricing.ts.
  discountPct Float @default(0)
  discountAmt Float @default(0)

  gstRatePct Float   @default(0)
  hsnCode    String?

  /// Which route this line follows. WHO does each stage lives on the stage rows,
  /// so any mix is possible — e.g. 1-3 in-house, 4 outsourced, 5-6 in-house.
  stageLineId Int?

  order     Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product    @relation(fields: [productId], references: [id])
  stageLine StageLine? @relation(fields: [stageLineId], references: [id])

  stages   OrderLineStage[]
  moves    StageMove[]
  sheet    OperationSheet?
  schedule OrderLineSchedule?

  finishedTxns   FinishedTxn[]
  packingBatches PackingBatch[]
  invoiceLines   InvoiceLine[]
}

/// When an order line SHOULD be at each stage.
///
/// A deliberate overlay on the board, not a replacement: `StageMove` says where pieces
/// ARE and that stays derived from the ledger. Nothing here ever feeds a quantity.
model OrderLineSchedule {
  id            Int       @id @default(autoincrement())
  orderLineId   Int       @unique
  orderId       Int
  /// When this line is expected to be fully finished.
  estimatedDone DateTime?
  createdById   Int?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  orderLine OrderLine       @relation(fields: [orderLineId], references: [id], onDelete: Cascade)
  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  stages    StageSchedule[]

  @@index([orderId])
}

/// Estimated start and end for one stage of one order line.
model StageSchedule {
  id               Int       @id @default(autoincrement())
  scheduleId       Int
  orderLineStageId Int
  estimatedStart   DateTime?
  estimatedEnd     DateTime?

  schedule       OrderLineSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  orderLineStage OrderLineStage    @relation(fields: [orderLineStageId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, orderLineStageId])
}

/// One stage of one order line — the snapshot of a StageLineStep.
model OrderLineStage {
  id          Int     @id @default(autoincrement())
  orderLineId Int
  name        String
  sortOrder   Int     @default(0)
  vendorId    Int? // null = in-house
  jobworkRate Float   @default(0) // ₹ per piece payable to the vendor for this stage
  /// ₹ per piece earned by an in-house worker who clears this stage. Defaulted from
  /// the product's LABOUR lines mapped to this step, then editable per order.
  /// Zero is allowed (day-wage work), but naming workers on a move then requires one.
  labourRate  Float   @default(0)
  note        String?

  orderLine OrderLine   @relation(fields: [orderLineId], references: [id], onDelete: Cascade)
  vendor    Supplier?   @relation("StageVendor", fields: [vendorId], references: [id])
  movesFrom      StageMove[]     @relation("MoveFrom")
  movesTo        StageMove[]     @relation("MoveTo")
  stageSchedules StageSchedule[]

  @@unique([orderLineId, sortOrder])
}

/// Append-only ledger of piece movements. How many pieces sit where is always
/// DERIVED from these rows (see lib/production.ts) and never stored, so the board
/// can never drift out of sync with its own history.
///
///   RELEASE  : PENDING   -> toStage
///   ADVANCE  : fromStage -> toStage           (forward)
///   REJECT   : fromStage -> toStage / PENDING (backward — rework)
///   COMPLETE : fromStage -> DONE
///   RETURN   : DONE      -> toStage           (undo a completion)
model StageMove {
  id          Int      @id @default(autoincrement())
  orderLineId Int
  kind        String
  fromStageId Int?
  toStageId   Int?
  qty         Int
  date        DateTime @default(now())
  /// Free-text hand-over comment written when the pieces were passed on.
  note        String?
  /// Does this clearance EARN anything?
  ///
  /// True for ordinary work. False for rework the vendor or the worker caused themselves —
  /// pieces they spoiled and are putting right at their own cost. Without it a vendor whose
  /// coating blistered was paid twice for the same forty pieces, because the board counts
  /// movements and rework is a genuine second movement.
  ///
  /// It is a property of the MOVEMENT rather than of the rejection that preceded it, because
  /// that is where the decision is actually made: the pieces come back, somebody agrees who
  /// carries the cost, and the re-clearance is recorded accordingly. A rejection on its own
  /// settles nothing.
  billable    Boolean  @default(true)
  createdById Int?
  createdAt   DateTime @default(now())

  orderLine OrderLine         @relation(fields: [orderLineId], references: [id], onDelete: Cascade)
  fromStage OrderLineStage?   @relation("MoveFrom", fields: [fromStageId], references: [id])
  toStage   OrderLineStage?   @relation("MoveTo", fields: [toStageId], references: [id])
  photos    StageMovePhoto[]
  workers   StageMoveWorker[]

  @@index([orderLineId])
}

/// Who did the work this movement records, and how many pieces each of them did.
///
/// Optional — the board never needed it and history without it stays valid. When
/// present the piece counts must sum to the movement's qty, so every rupee of
/// in-house labour is attributable and the total still reconciles with the board's
/// `cleared` figure. Earnings are pieces × the stage's CURRENT labourRate, exactly
/// as vendor jobwork is priced, so there is no rate to snapshot here.
model StageMoveWorker {
  id       Int @id @default(autoincrement())
  moveId   Int
  workerId Int
  pieces   Int

  move   StageMove @relation(fields: [moveId], references: [id], onDelete: Cascade)
  worker Worker    @relation(fields: [workerId], references: [id])

  @@unique([moveId, workerId])
  @@index([workerId])
}

/// Photos attached to a hand-over — proof of condition when pieces change hands.
model StageMovePhoto {
  id           Int      @id @default(autoincrement())
  moveId       Int
  filename     String
  originalName String?
  url          String
  caption      String?
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  move StageMove @relation(fields: [moveId], references: [id], onDelete: Cascade)

  @@index([moveId])
}

model Proforma {
  id            Int       @id @default(autoincrement())
  number        String    @unique
  buyerId       Int
  currencyId    Int?
  status        String    @default("Draft") // Draft|Sent|Accepted|Rejected
  date          DateTime  @default(now())
  validUntil    DateTime?
  paymentTerms  String?
  deliveryTerms String?
  incoterms     String?
  bankDetails   String?
  notes         String?
  exchangeRate  Float?

  /// The tax basis, SNAPSHOTTED when the document is created — the same discipline as
  /// `exchangeRate` and the stage steps. Read live, a later correction to the buyer's
  /// market or state would silently restate every document already issued: a GST
  /// quotation would reprint as an untaxed export, and receivables would move.
  taxMarket       String?
  taxBuyerState   String?
  taxCompanyState String?
  showImages    Boolean   @default(true) // print product photos on the PI
  sentAt        DateTime?
  decidedAt     DateTime? // when it was accepted or rejected
  rejectReason  String?
  createdById   Int?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  /// Soft delete. Set instead of removing the row, so nothing is ever unrecoverable.
  /// EVERY query that feeds a list or the money engine must filter `deletedAt: null` —
  /// see lib/softDelete.ts. Filtering happens at the query layer, never inside the pure
  /// functions, exactly as a cancelled order is excluded.
  deletedAt DateTime?

  buyer    Buyer            @relation(fields: [buyerId], references: [id])
  currency Currency?        @relation(fields: [currencyId], references: [id])
  lines    ProformaLine[]
  charges  ProformaCharge[]
  order    Order?           @relation("ProformaOrder")

  @@index([deletedAt])
}

/// An extra cost or a discount that belongs to the whole document rather than to one
/// product — freight, packing, loading, a dealer discount.
///
/// A charge carries its OWN gst rate instead of being apportioned across the product
/// lines, because that is how a real invoice bills freight and because apportioning
/// would make the tax on a line depend on unrelated lines. `isTaxable` false is for
/// something added after tax, e.g. a round-off.
model ProformaCharge {
  id         Int     @id @default(autoincrement())
  proformaId Int
  name       String
  /// CHARGE adds, DISCOUNT subtracts. Amounts are always stored positive; the kind is
  /// what decides the sign, so a discount can never accidentally read as a charge.
  kind       String  @default("CHARGE") // CHARGE | DISCOUNT
  /// Either a flat amount or a percentage of the line subtotal. Both may be set; the
  /// percentage is worked out first and the flat amount added to it.
  amount     Float   @default(0)
  pct        Float   @default(0)
  gstRatePct Float   @default(0)
  isTaxable  Boolean @default(true)
  note       String?
  sortOrder  Int     @default(0)

  proforma Proforma @relation(fields: [proformaId], references: [id], onDelete: Cascade)
}

model ProformaLine {
  id          Int    @id @default(autoincrement())
  proformaId  Int
  productId   Int?
  imageId     Int? // which product photo to print (null = the product's primary)
  description String
  qty         Int    @default(1)
  unitPrice   Float  @default(0)
  sortOrder   Int    @default(0)

  /// Per-line discount. The percentage comes off the gross first, then the flat amount
  /// — see `lineNet()` in lib/pricing.ts, which is the only place this is worked out.
  discountPct Float @default(0)
  discountAmt Float @default(0)

  /// Tax for this line, seeded from the product and overridable. Ignored entirely on an
  /// overseas document, where exports are zero-rated.
  gstRatePct Float   @default(0)
  hsnCode    String?

  proforma Proforma      @relation(fields: [proformaId], references: [id], onDelete: Cascade)
  product  Product?      @relation(fields: [productId], references: [id])
  image    ProductImage? @relation("ProformaLineImage", fields: [imageId], references: [id])
}

/// "Material sheet" — a numbered printout of the live costing explosion for a
/// product × qty (what to buy / issue to the floor). Production PROGRESS lives on
/// the order board (OrderLineStage + StageMove), never here.
model OperationSheet {
  id          Int      @id @default(autoincrement())
  number      String   @unique
  productId   Int
  orderId     Int?
  orderLineId Int?     @unique
  qty         Int      @default(1)
  notes       String?
  createdById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// Soft delete. Set instead of removing the row, so nothing is ever unrecoverable.
  /// EVERY query that feeds a list or the money engine must filter `deletedAt: null` —
  /// see lib/softDelete.ts. Filtering happens at the query layer, never inside the pure
  /// functions, exactly as a cancelled order is excluded.
  deletedAt DateTime?

  product   Product    @relation(fields: [productId], references: [id])
  order     Order?     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderLine OrderLine? @relation(fields: [orderLineId], references: [id], onDelete: Cascade)

  @@index([deletedAt])
}

/// Money that actually moved, plus manually-entered bills.
///
/// What is OWED is never entered by hand where the system already knows it:
///   - buyer receivable  = order value            - BUYER receipts
///   - jobwork payable   = board-accrued jobwork  - JOBWORK payments
/// So BUYER and JOBWORK rows are PAYMENT rows only; SUPPLIER (material) and WORKER
/// rows may be BILL or PAYMENT because nothing else knows those amounts.
model LedgerEntry {
  id                   Int      @id @default(autoincrement())
  partyType            String // SUPPLIER | JOBWORK | BUYER | WORKER | CONTRACTOR | STATUTORY
  supplierId           Int?
  buyerId              Int?
  /// Set on WORKER rows once the Manforce module owns the worker. Wages used to be
  /// recorded against a typed name, so `partyName` remains the fallback for history
  /// that predates the worker master.
  workerId             Int?
  contractorId         Int?
  /// Set on STATUTORY rows: which levy this payment settles (PF, ESI, …).
  statutoryComponentId Int?
  /// The order this money is aimed at. Optional: a payment with no order — or one
  /// larger than that order's balance — is spread oldest-first across whatever the
  /// party still owes or is owed (see lib/finance.ts). Allocation is computed on
  /// read, never stored, so it cannot go stale when values change.
  orderId              Int?
  stockTxnId           Int?     @unique // set when this bill covers a specific stock receipt
  /// Set when this payment IS the handing over of an advance. The advance record holds
  /// the recovery terms; the cash lives here, so it is counted exactly once.
  advanceId            Int?     @unique
  /// The invoice a buyer receipt is aimed at, under `AppSetting.receivableBasis = INVOICE`.
  /// Optional and advisory in exactly the way `orderId` is: it says where the money was
  /// AIMED, not where FIFO landed it. Never read this to work out what an invoice has
  /// been paid — `buildFinanceContext()` allocates it, and its answer is the only one.
  invoiceId            Int?
  partyName            String // snapshot / for WORKER
  kind                 String // BILL | PAYMENT
  amount               Float
  currency             String?  @default("INR")
  date                 DateTime @default(now())
  ref                  String?
  note                 String?
  createdById          Int?
  createdAt            DateTime @default(now())

  /// Soft delete. Set instead of removing the row, so nothing is ever unrecoverable.
  /// EVERY query that feeds a list or the money engine must filter `deletedAt: null` —
  /// see lib/softDelete.ts. Filtering happens at the query layer, never inside the pure
  /// functions, exactly as a cancelled order is excluded.
  deletedAt DateTime?

  supplier   Supplier?           @relation("SupplierLedger", fields: [supplierId], references: [id])
  buyer      Buyer?              @relation("BuyerLedger", fields: [buyerId], references: [id])
  order      Order?              @relation(fields: [orderId], references: [id])
  stockTxn   StockTxn?           @relation(fields: [stockTxnId], references: [id])
  worker     Worker?             @relation(fields: [workerId], references: [id])
  contractor Contractor?         @relation(fields: [contractorId], references: [id])
  component  StatutoryComponent? @relation(fields: [statutoryComponentId], references: [id])
  advance    WorkerAdvance?      @relation(fields: [advanceId], references: [id])
  invoice    Invoice?            @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
  @@index([orderId])
  @@index([partyType, supplierId])
  @@index([partyType, buyerId])
  @@index([partyType, workerId])
  @@index([partyType, contractorId])

  @@index([deletedAt])
}

model DocSequence {
  id      Int     @id @default(autoincrement())
  /// PI | ORD | OP | WRK | CTR | STP | DPI | DORD | INV | DINV | SHP | PKL
  ///
  /// INV and DINV are year-formatted (see YEAR_KEYS in lib/numbering.ts), because an
  /// invoice series is quoted by financial year exactly as PI/ORD are. SHP and PKL are
  /// internal handles and stay flat.
  key     String  @unique
  prefix  String
  useYear Boolean @default(false)
  lastNo  Int     @default(0)
}

/// App-wide settings that belong to no single module. Singleton (id = 1).
/// Who WE are. Singleton (id = 1), Admin-editable in Master Data → Company.
///
/// `state` is not decoration: comparing it with the buyer's state is what decides
/// CGST+SGST (same state) versus IGST (different), so the tax split is derived rather
/// than typed. The address and GSTIN also give documents a letterhead.
model Company {
  id Int @id @default(1)

  legalName String  @default("Oswal Handicrafts")
  tradeName String?
  addressL1 String?
  addressL2 String?
  city      String?
  state     String?
  pincode   String?
  country   String  @default("India")

  gstNo String?
  panNo String?
  iecNo String? // importer-exporter code, for export documents
  cinNo String?

  phone   String?
  email   String?
  website String?

  /// Printed on a proforma when the buyer has to remit money.
  bankDetails String?

  /// Letterhead logo, in server/uploads. Stored as a filename only, like every other
  /// upload, so the served URL is built the same way.
  logoFilename String?

  updatedAt DateTime @updatedAt
}

model AppSetting {
  id Int @id @default(1)

  /// How far back a "what did we use last time" suggestion looks. Older figures are
  /// not shown at all — a two-year-old rate is worse than no rate.
  suggestionWindowDays Int   @default(365)
  /// A typed figure this far from the window's average is flagged as out of line.
  outlierPct           Float @default(25)

  /// What makes a buyer owe money: ORDER | INVOICE.
  ///
  /// ORDER (the default, and how the app has always worked) — a confirmed order is the
  /// debt. INVOICE — only invoiced goods are, and a confirmed order not yet shipped
  /// shows as *order book* instead.
  ///
  /// Switching this RESTATES every balance and statement on the next read, with no
  /// migration and nothing to rebuild, because allocation is a pure function of
  /// (buckets, payments) recomputed on every request — see lib/finance.ts. That is also
  /// why the basis must be applied INSIDE `buildFinanceContext()` and nowhere else: a
  /// route that branched on it separately would make the order page and the Payments
  /// page disagree.
  receivableBasis      String @default("ORDER")

  updatedAt DateTime @updatedAt
}

/// An edit to a figure that matters: a rate, a price, a wage.
///
/// Suggestions are DERIVED from the live records, so they answer "what did we use".
/// This answers the different question "who changed it, and what was it before" —
/// which nothing else can reconstruct, because an edit overwrites the old value.
/// Only money and rates are logged; ordinary edits are not worth the noise.
model ChangeLog {
  id Int @id @default(autoincrement())

  /// The record that actually changed, e.g. CostLine.
  entity   String
  entityId Int?
  /// The record a person would go looking at — the product, order or worker that owns
  /// it. Cost lines are replaced wholesale on save, so their own ids are not stable.
  rootType String
  rootId   Int

  field    String
  /// Human-readable subject, e.g. `CARVING LABOUR — rate`.
  label    String
  /// Stored as text so one table can hold money, percentages and names alike.
  oldValue String?
  newValue String?
  note     String?

  userId   Int?
  userName String   @default("")
  at       DateTime @default(now())

  @@index([rootType, rootId, at])
  @@index([entity, entityId])
}

// ---------------------------------------------------------------------------
// Manforce module (Phase 3) — workers, attendance, wages, statutory dues.
//
// THERE ARE NO PAY PERIODS. The factory pays people when it pays them: a worker
// may draw an advance, or go unpaid for two months. So a worker is a running
// ACCOUNT, exactly like a jobwork vendor — earnings accrue as dated events and
// payments are ad-hoc for any amount on any date. Nothing is ever "run" or closed.
//
// Consequently NO BALANCE IS EVER STORED. What a worker has earned is derived from
// (attendance × their rate) + (pieces cleared × the stage's labour rate), the same
// discipline the production board follows. See lib/workforce.ts.
// ---------------------------------------------------------------------------

model Trade {
  id        Int      @id @default(autoincrement())
  name      String   @unique // Carpenter | Polisher | Helper | Packer …
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workers Worker[]
}

/// A labour contractor. Their gang's earnings roll up here and one payment settles
/// the lot, with the per-worker breakdown kept behind it — so a contractor is a
/// party with its own ledger, not a label on a worker.
model Contractor {
  id           Int      @id @default(autoincrement())
  code         String   @unique
  name         String
  contactName  String?
  phone        String?
  email        String?
  gstNo        String?
  panNo        String?
  address      String?
  paymentTerms String?
  isActive     Boolean  @default(true)
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workers Worker[]
  ledger  LedgerEntry[]
}

model Worker {
  id           Int    @id @default(autoincrement())
  code         String @unique
  name         String
  tradeId      Int?
  /// null = paid directly by the factory; set = part of a contractor's gang.
  contractorId Int?

  /// DAY (daily rate × days present) | PIECE (board clearances) | MONTHLY (salary
  /// accrued pro-rata across working days). One worker earns by exactly one of these,
  /// so attendance can never double-pay a piece-rate worker.
  payType       String @default("DAY")
  dailyRate     Float  @default(0)
  otHourlyRate  Float  @default(0)
  monthlySalary Float  @default(0)

  joinedOn   DateTime  @default(now())
  exitOn     DateTime?
  exitReason String?
  isActive   Boolean   @default(true)

  /// Wages are DERIVED from this date onwards; before it only hand-recorded entries
  /// count. Wages used to be typed against a name, so a worker migrated from that
  /// history starts accruing after their last manual entry — otherwise the engine
  /// would invent presumed-present days for a period that was already paid.
  /// Null means "derive from joinedOn", which is the case for every new worker.
  accrualFrom DateTime?

  // contact / personal
  phone          String?
  altPhone       String?
  address        String?
  guardianName   String?
  emergencyName  String?
  emergencyPhone String?
  dateOfBirth    DateTime?
  gender         String?

  // identity and payout — sensitive, only served to Manager and above
  aadhaarNo     String?
  panNo         String?
  uanNo         String? // PF universal account number
  esicNo        String? // ESIC insured-person number
  bankName      String?
  bankAccountNo String?
  bankIfsc      String?
  upiId         String?

  notes       String?
  createdById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  trade      Trade?      @relation(fields: [tradeId], references: [id])
  contractor Contractor? @relation(fields: [contractorId], references: [id])

  documents    WorkerDocument[]
  attendance   Attendance[]
  advances     WorkerAdvance[]
  deductions   WorkerDeduction[]
  statutory    WorkerStatutory[]
  moveWorkers  StageMoveWorker[]
  postingLines StatutoryPostingLine[]
  ledger       LedgerEntry[]

  @@index([isActive])
  @@index([contractorId])
}

/// Worker photo and ID scans. Same content-checked pipeline as product images:
/// the magic bytes are verified and anything that is not really an image is unlinked.
model WorkerDocument {
  id           Int      @id @default(autoincrement())
  workerId     Int
  kind         String   @default("PHOTO") // PHOTO | ID
  label        String?
  filename     String
  originalName String?
  url          String
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  worker Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([workerId])
}

/// Which levies a worker is covered by. Absence of a row means not covered, so
/// casual labour costs nothing to leave out.
model WorkerStatutory {
  id          Int     @id @default(autoincrement())
  workerId    Int
  componentId Int
  covered     Boolean @default(true)

  worker    Worker             @relation(fields: [workerId], references: [id], onDelete: Cascade)
  component StatutoryComponent @relation(fields: [componentId], references: [id], onDelete: Cascade)

  @@unique([workerId, componentId])
}

/// Attendance is EXCEPTIONS-ONLY: a row exists to say something other than the
/// presumption. Everyone active is presumed present on a working day, so absences,
/// half-days, leave and overtime are what get recorded — plus an explicit PRESENT to
/// pay someone who came in on a weekly off or holiday.
///
/// Which days are working days is Admin-configured (WorkforceSetting + Holiday), and
/// because the accrual is derived, adding a festival to the calendar retroactively
/// corrects the money.
model Attendance {
  id          Int      @id @default(autoincrement())
  workerId    Int
  date        DateTime // midnight, date-only
  status      String // PRESENT | ABSENT | HALF_DAY | LEAVE | PAID_LEAVE
  otHours     Float    @default(0)
  note        String?
  createdById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  worker Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@unique([workerId, date])
  @@index([date])
}

/// A non-working day for the whole factory. Deleting one restates the accrual, which
/// is the point of deriving rather than storing.
model Holiday {
  id        Int      @id @default(autoincrement())
  date      DateTime @unique
  name      String
  createdAt DateTime @default(now())
}

/// Singleton (id = 1) holding the rules the Admin decides.
model WorkforceSetting {
  id Int @id @default(1)

  /// CSV of JS day numbers that are weekly offs — "0" = Sunday.
  weeklyOffDays          String  @default("0")
  /// When true an active worker is presumed present on every working day unless a
  /// row says otherwise. When false only explicitly marked days earn.
  presumePresent         Boolean @default(true)
  shiftHours             Float   @default(8)
  /// Used to derive an OT rate for a worker who has no otHourlyRate of their own:
  /// (dailyRate ÷ shiftHours) × this.
  otMultiplier           Float   @default(2)
  halfDayFactor          Float   @default(0.5)
  /// How a monthly salary is spread over a month: WORKING (working days in that
  /// month) | FIXED_26 | FIXED_30 | CALENDAR.
  monthlyDivisor         String  @default("WORKING")
  /// Default ₹/month recovered from earnings against a new advance; 0 = no cap.
  defaultAdvanceRecovery Float   @default(0)

  updatedAt DateTime @updatedAt
}

/// Money handed to a worker ahead of their earnings.
///
/// The CASH lives on the linked LedgerEntry PAYMENT row, so it is counted once. This
/// record holds the recovery terms: earnings absorb the advance at most
/// `recoveryPerMonth` per calendar month (0 = absorb as fast as earnings allow, which
/// is the same thing as a payment that simply outran the earnings).
model WorkerAdvance {
  id               Int      @id @default(autoincrement())
  workerId         Int
  date             DateTime @default(now())
  amount           Float
  recoveryPerMonth Float    @default(0)
  ref              String?
  note             String?
  createdById      Int?
  createdAt        DateTime @default(now())

  worker  Worker       @relation(fields: [workerId], references: [id], onDelete: Cascade)
  payment LedgerEntry?

  @@index([workerId])
}

/// A charge against a worker — canteen, damage, tool loss, fine. Reduces what is
/// owed without any cash moving.
model WorkerDeduction {
  id          Int      @id @default(autoincrement())
  workerId    Int
  date        DateTime @default(now())
  reason      String
  amount      Float
  note        String?
  createdById Int?
  createdAt   DateTime @default(now())

  worker Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([workerId])
}

/// A statutory levy, defined as DATA exactly as CostMethod defines cost formulas —
/// so a change in the law is an edit, not a release. PF, ESI, PT and bonus ship as
/// editable defaults.
model StatutoryComponent {
  id   Int    @id @default(autoincrement())
  code String @unique // PF | ESI | PT | BONUS …
  name String

  employeePct Float @default(0) // deducted from the worker
  employerPct Float @default(0) // the factory's own cost
  /// A flat amount instead of a percentage (professional tax). Applied when the wage
  /// base reaches `minWages`.
  flatAmount  Float @default(0)

  /// What the percentages apply to: GROSS (everything earned) | BASIC (excluding
  /// overtime, which is how PF is normally computed).
  basis String @default("GROSS")

  /// Contribution is computed on min(wages, wageCeiling) — PF's ₹15,000 today.
  wageCeiling        Float?
  /// A worker earning more than this in the period is not covered at all — ESI's
  /// ₹21,000 today.
  eligibilityCeiling Float?
  minWages           Float?

  /// Who the money is owed to once posted.
  payeeName   String   @default("")
  /// A provision (bonus, gratuity) accrues as a cost but is not a payable until
  /// declared, so it stays out of the payables total.
  isProvision Boolean  @default(false)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  coverage WorkerStatutory[]
  lines    StatutoryPostingLine[]
  ledger   LedgerEntry[]
}

/// Liability is incurred only when the Admin posts it. Until then the screen shows
/// what is unposted and nothing exists in the accounts. Two postings of the same
/// component may not cover overlapping dates.
model StatutoryPosting {
  id          Int      @id @default(autoincrement())
  number      String   @unique
  periodFrom  DateTime
  periodTo    DateTime
  postedOn    DateTime @default(now())
  note        String?
  createdById Int?
  createdAt   DateTime @default(now())

  lines StatutoryPostingLine[]
}

model StatutoryPostingLine {
  id          Int   @id @default(autoincrement())
  postingId   Int
  componentId Int
  workerId    Int
  /// The wage base the contribution was worked out on, kept because the earnings it
  /// came from can be restated later (a holiday added, a rate corrected) and a posted
  /// liability must not silently change.
  wages       Float
  employeeAmt Float @default(0)
  employerAmt Float @default(0)

  posting   StatutoryPosting   @relation(fields: [postingId], references: [id], onDelete: Cascade)
  component StatutoryComponent @relation(fields: [componentId], references: [id])
  worker    Worker             @relation(fields: [workerId], references: [id])

  @@unique([postingId, componentId, workerId])
  @@index([componentId])
  @@index([workerId])
}

// ---------------------------------------------------------------------------
// Finished goods and sales
//
// The board ends at DONE. Everything below carries those pieces out of the factory:
// what is finished, how it is packed, what fits in the container, what left, and what
// was billed for it.
//
// The rule the whole section obeys: ONLY FACTS ARE STORED. There is no quantity on
// hand, no packed count, no shipped count and no invoice total anywhere in it. Every
// one of those is summed from these rows on read — the same discipline that makes
// `StageMove` the single source of truth for where pieces are.
// ---------------------------------------------------------------------------

/// A box size the factory ships in, with what it can hold. Admin-defined DATA, seeded
/// from `BUILTIN_CONTAINER_TYPES` exactly as `BUILTIN_METHODS` seeds the cost formulas
/// and `BUILTIN_STATUTORY` the levies — a new box size is a row, not a release.
///
/// Master data, so `isActive` and NOT `deletedAt`: a second way to hide a row would mean
/// two mechanisms doing one job (see lib/softDelete.ts).
model ContainerType {
  id          Int     @id @default(autoincrement())
  code        String  @unique // 20FT | 40FT | 40HQ | LCL
  name        String
  /// Usable internal volume in m3, and the most it may legally carry.
  capacityCbm Float   @default(0)
  payloadKg   Float   @default(0)
  isActive    Boolean @default(true)
  sortOrder   Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  containers ShipmentContainer[]
}

/// Finished stock that did NOT come off the production board.
///
/// Board completions are deliberately absent from this table. `buildBoard()`'s DONE
/// bucket is read live, so undoing a `StageMove` un-does the stock and a RETURN move
/// reduces it for free. Writing a row here on COMPLETE as well would be two records of
/// one fact, and they would drift the first time a movement was undone.
///
/// So this holds only what the board cannot know: an opening balance, damage, a physical
/// count correction, and goods coming back from a buyer. Bought-in finished goods are not
/// here either — they arrive as an ordinary supplier receipt (see `RawItem.productId`),
/// so they bill through the supplier ledger without a second mechanism.
model FinishedTxn {
  id        Int    @id @default(autoincrement())
  productId Int
  /// ADJUST_IN | ADJUST_OUT | RETURN_IN
  kind      String
  /// Always POSITIVE. `kind` carries the direction, so a negative typed against an
  /// ADJUST_OUT cannot quietly turn it back into a receipt — the same reason
  /// `OrderCharge.kind` carries the sign rather than the amount.
  qty       Int

  /// Which order line's pieces these are. Null = FREE POOL: an opening balance,
  /// over-production, bought-in goods and returns belong to no order, and any order may
  /// draw on them.
  orderLineId    Int?
  /// What came back, on a RETURN_IN — so a return is explained by the dispatch it reverses.
  shipmentLineId Int?

  /// OPENING | DAMAGE | PHYSICAL_COUNT | RETURN, plus free text.
  reason String?
  note   String?

  date        DateTime @default(now())
  createdById Int?
  createdAt   DateTime @default(now())

  product      Product       @relation(fields: [productId], references: [id])
  orderLine    OrderLine?    @relation(fields: [orderLineId], references: [id])
  shipmentLine ShipmentLine? @relation(fields: [shipmentLineId], references: [id])

  @@index([productId])
  @@index([orderLineId])
  @@index([date])
}

/// Finished pieces put into cartons, ready to load.
///
/// The carton count is DERIVED from `piecesPerCarton`, and the dimensions and weights are
/// pre-filled from the product master — the packer overrides only what differs on the day.
/// Everything the master supplied is SNAPSHOTTED here, because the master may legitimately
/// be corrected later and a packing list already printed must not change.
model PackingBatch {
  id          Int  @id @default(autoincrement())
  productId   Int
  /// Null = free-pool goods, as on FinishedTxn.
  orderLineId Int?

  /// Pieces in this batch, and the boxes they went into.
  qty         Int
  cartonCount Int

  /// SNAPSHOT of the master's figures at the moment of packing.
  ///
  /// `piecesPerCarton` is here because the carton count means nothing without it, and
  /// because a part carton is only recognisable as one by comparing the two.
  piecesPerCarton Int
  packLengthIn    Float?
  packWidthIn     Float?
  packHeightIn    Float?
  /// Per PIECE, matching how the product master stores them.
  netWeightKg     Float?
  grossWeightKg   Float?
  /// Per PIECE, matching `Product.volumeAfterPackingCbm` — which is a per-piece figure,
  /// NOT a per-carton one. Carton volume is this multiplied by the pieces in that carton.
  /// Getting it wrong under-reports a load by a factor of `piecesPerCarton`.
  cbmPerPiece     Float?

  /// Set ONLY when the packer measured the box itself and it disagreed with the
  /// dimensions. A separate column, so a printed CBM is always explained by either the
  /// dimensions or an explicit human statement — never by an unattributable number.
  cbmPerCartonOverride Float?

  /// The marks stencilled on the boxes.
  shippingMarks String?
  note          String?

  packedOn    DateTime @default(now())
  createdById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product   Product    @relation(fields: [productId], references: [id])
  orderLine OrderLine? @relation(fields: [orderLineId], references: [id])

  lines ShipmentLine[]

  @@index([productId])
  @@index([orderLineId])
}

/// A physical dispatch: cartons in containers, leaving the factory.
///
/// A shipment carries NO MONEY AT ALL. Freight and insurance are charges on the invoice,
/// through the same machinery a proforma and an order already use. Keeping money off this
/// record is what makes "a shipment is fulfilment, an invoice is money" hold.
///
/// There is deliberately no `buyerId`. A container may be co-loaded for more than one
/// buyer, and the buyer of any given carton is known from the order line behind its
/// packing batch. The INVOICE is per buyer; the box need not be.
model Shipment {
  id     Int    @id @default(autoincrement())
  number String @unique
  /// PLANNED | LOADED | SHIPPED | DELIVERED | CANCELLED
  status String @default("PLANNED")

  shipDate DateTime?

  /// Export paperwork. Printed on the invoice and the annexures.
  shippingBillNo   String?
  shippingBillDate DateTime?
  portOfLoading    String?
  portOfDischarge  String?
  finalDestination String?
  vesselOrFlight   String?
  blAwbNo          String?
  blAwbDate        DateTime?

  /// Domestic movement paperwork. ALL OPTIONAL and typed in — there is no portal
  /// integration here, exactly as the ICEGATE rates are pasted rather than scraped.
  transporterName  String?
  transporterGstin String?
  vehicleNo        String?
  ewayBillNo       String?
  ewayBillDate     DateTime?

  notes String?

  createdById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// Soft delete. Set instead of removing the row, so nothing is ever unrecoverable.
  /// EVERY query that feeds a list or the money engine must filter `deletedAt: null` —
  /// see lib/softDelete.ts. Filtering happens at the query layer, never inside the pure
  /// functions. An INVOICED shipment cannot be deleted at all; cancel the invoice first.
  deletedAt DateTime?

  containers ShipmentContainer[]
  lines      ShipmentLine[]
  invoices   Invoice[]

  @@index([status])
  @@index([shipDate])
  @@index([deletedAt])
}

/// One box on a shipment.
model ShipmentContainer {
  id              Int     @id @default(autoincrement())
  shipmentId      Int
  containerTypeId Int
  containerNo     String?
  sealNo          String?
  /// The empty weight stencilled on the box. VGM is NOT stored — it is this plus the
  /// derived gross of what went in, so it can never contradict the packing list.
  tareWeightKg    Float?
  note            String?
  sortOrder       Int     @default(0)

  shipment      Shipment      @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  containerType ContainerType @relation(fields: [containerTypeId], references: [id])

  lines ShipmentLine[]

  @@index([shipmentId])
  @@index([containerTypeId])
}

/// Cartons out of one packing batch, going into one container.
model ShipmentLine {
  id             Int  @id @default(autoincrement())
  shipmentId     Int
  packingBatchId Int
  /// Null until the cartons are assigned to a box — an LCL load may never be.
  containerId    Int?

  /// BOTH are stored, and neither derives the other reliably: a short last carton breaks
  /// `qty = cartons * piecesPerCarton`, and pieces are what stock and the invoice are
  /// counted in while cartons are what space and weight are counted in. The route
  /// validates that qty cannot exceed what that many cartons could hold.
  cartons Int
  qty     Int

  sortOrder Int @default(0)

  shipment     Shipment           @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  packingBatch PackingBatch       @relation(fields: [packingBatchId], references: [id])
  container    ShipmentContainer? @relation(fields: [containerId], references: [id])

  returns      FinishedTxn[]
  invoiceLines InvoiceLine[]

  @@index([shipmentId])
  @@index([packingBatchId])
  @@index([containerId])
}

/// What a buyer is billed for a dispatch. A commercial invoice for an export, a GST tax
/// invoice for a domestic sale — one model, titled by market, exactly as a proforma is a
/// Quotation domestically.
///
/// **It stores no total.** Its lines COPY their price inputs from the order line at the
/// moment it is raised — the same thing accepting a proforma does when it copies charges
/// onto the order — and every figure on it is then produced by `documentValueOf()` /
/// `documentTotalsOf()` in lib/pricing.ts. That is how both rules hold at once: the
/// document is frozen against a later correction to the order (the property
/// `StatutoryPostingLine.wages` exists for), yet no figure on it can contradict the one
/// pricing engine that the order page and the Payments page also read.
///
/// An invoice may span SEVERAL ORDERS of one buyer. It is per buyer, because tax and
/// currency are.
model Invoice {
  id     Int    @id @default(autoincrement())
  number String @unique
  /// DRAFT | ISSUED | CANCELLED. A cancelled invoice KEEPS its number — a gap in an
  /// invoice series is a compliance problem — and drops out of every total the way a
  /// cancelled order does.
  status String @default("DRAFT")

  buyerId      Int
  currencyId   Int?
  /// The buyer currency's rateToBase, SNAPSHOTTED here as `Order.exchangeRate` is. A
  /// currency change must restate it, or the invoice books a phantom forex movement.
  exchangeRate Float?

  invoiceDate DateTime  @default(now())
  dueDate     DateTime?
  /// The dispatch being billed. Optional only so a draft may exist for a moment before
  /// its shipment is attached; the route refuses to ISSUE one without.
  shipmentId  Int?

  incoterms String?

  /// The tax basis, SNAPSHOTTED when the document is created — the same discipline as
  /// `Order.taxMarket`, and for the same reason. Read live, a later correction to the
  /// buyer's state would reprint an issued invoice with a different tax split.
  taxMarket       String?
  taxBuyerState   String?
  taxCompanyState String?

  /// Domestic compliance, ALL OPTIONAL. `placeOfSupply` is recorded rather than derived,
  /// because it is what the document must say it was even if the address is later fixed.
  placeOfSupply String?
  reverseCharge Boolean   @default(false)
  irn           String?
  ackNo         String?
  ackDate       DateTime?
  /// The e-invoice QR, through lib/imageUpload.ts like every other image — magic bytes,
  /// not the declared mimetype. Named `invoice-qr-*` so it is identifiable on disk, and
  /// unlinked when the invoice is destroyed.
  qrFilename    String?

  paymentTerms String?
  bankDetails  String?
  notes        String?

  createdById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// Soft delete — see Shipment.deletedAt.
  deletedAt DateTime?

  buyer    Buyer     @relation(fields: [buyerId], references: [id])
  currency Currency? @relation(fields: [currencyId], references: [id])
  shipment Shipment? @relation(fields: [shipmentId], references: [id])

  lines   InvoiceLine[]
  charges InvoiceCharge[]
  ledger  LedgerEntry[]

  @@index([buyerId])
  @@index([shipmentId])
  @@index([status])
  @@index([invoiceDate])
  @@index([deletedAt])
}

/// One billed line. The price inputs are COPIES, taken from the order line when the
/// invoice was raised — never edited here, and there is no input in the UI to edit them
/// with. Same shape and same maths as `OrderLine` / `ProformaLine`, so `lineNet()` in
/// lib/pricing.ts prices all three.
model InvoiceLine {
  id        Int @id @default(autoincrement())
  invoiceId Int
  productId Int

  /// Which order this line bills. This is what lets one invoice span several orders, and
  /// it is what the per-order attribution of a receipt is built from under the INVOICE
  /// receivable basis.
  orderLineId    Int?
  /// The dispatch this line bills, so the invoice reconciles to the packing list.
  shipmentLineId Int?

  qty       Int
  unitPrice Float @default(0) // in invoice currency

  discountPct Float @default(0)
  discountAmt Float @default(0)

  gstRatePct Float   @default(0)
  hsnCode    String?

  description String?
  sortOrder   Int     @default(0)

  invoice      Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product      Product       @relation(fields: [productId], references: [id])
  orderLine    OrderLine?    @relation(fields: [orderLineId], references: [id])
  shipmentLine ShipmentLine? @relation(fields: [shipmentLineId], references: [id])

  @@index([invoiceId])
  @@index([orderLineId])
}

/// Freight, insurance, packing — what turns an FOB price into CFR or CIF. Belongs to the
/// whole document and carries its OWN gst rate rather than being apportioned across the
/// lines, exactly as `OrderCharge` does; a percentage charge is a percentage of the line
/// subtotal only, so charges never compound and the order they were entered in cannot
/// change the total.
model InvoiceCharge {
  id         Int     @id @default(autoincrement())
  invoiceId  Int
  /// Which order this charge was COPIED FROM, when it came across with the goods.
  ///
  /// Freight and insurance are agreed once on the proforma and carried onto the order, so an
  /// invoice raised for that order has to bill them or the buyer pays for the goods and the
  /// order is left owing the freight for ever. They must also be billed ONCE: an order shipped
  /// in two containers gets two invoices, and only the first carries the charge. That is what
  /// this column is for — it is the record of "this order's charges have already gone out".
  ///
  /// NULL means the charge was added on the invoice itself, which is the ordinary case for
  /// something that only became known at dispatch.
  orderId    Int?
  name       String
  kind       String  @default("CHARGE") // CHARGE | DISCOUNT
  amount     Float   @default(0)
  pct        Float   @default(0)
  gstRatePct Float   @default(0)
  isTaxable  Boolean @default(true)
  note       String?
  sortOrder  Int     @default(0)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}
