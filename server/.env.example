# Copy to server/.env and fill in. server/.env is git-ignored.

# Postgres. The development cluster lives INSIDE this repository — the server binaries
# come from the `embedded-postgres` npm package and the data directory is
# `server/.pgdata`, so there is nothing to install and nothing to run in Docker:
#   npm install && npm run pg:start && npm run db:setup
#
# This one URL is the only place the port, user, password and database name are stated;
# `scripts/pg.ts` parses them out of it to create and start the cluster, so the server
# cannot end up listening somewhere Prisma is not looking. Change it and both follow.
#
# Port 5433 rather than 5432 keeps it clear of a system-wide Postgres. The cluster
# listens on localhost only, which is why a fixed development password is fine here;
# a hosted database needs a real one, and then `npm run pg:*` refuses to touch it.
DATABASE_URL="postgresql://postgres:oswal_local@127.0.0.1:687/oswal?schema=public"

PORT=689
NODE_ENV=development

# Signs login tokens. REQUIRED in production, where it is also refused if it is a
# known placeholder or shorter than 32 characters — anyone holding it can mint valid
# logins. Left blank in development, a random secret is generated per boot, which
# invalidates existing sessions on every restart.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""

# Browser origins allowed to call the API, comma-separated. Defaults to the Vite dev
# server in development; set it explicitly in production.
# CORS_ORIGINS="https://erp.oswalhandicrafts.example"

# How long a login lasts. The app renews it quietly while someone is working.
# TOKEN_TTL=12h

# Printed on proformas and in e-mail signatures.
# COMPANY_NAME="Oswal Handicrafts"
# COMPANY_TAGLINE="Furniture & Hardware Exporter"
# COMPANY_ADDRESS="Jodhpur, Rajasthan, India"
# COMPANY_GST=""
# COMPANY_IEC=""
# COMPANY_EMAIL=""
# COMPANY_PHONE=""
# COMPANY_WEBSITE=""
