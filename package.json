{
  "name": "oswal-erp",
  "version": "0.1.0",
  "private": true,
  "description": "ERP for Oswal Handicrafts — Product Management + Operations",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "pg:start": "npm --workspace server run pg:start",
    "pg:stop": "npm --workspace server run pg:stop",
    "pg:restart": "npm --workspace server run pg:restart",
    "pg:status": "npm --workspace server run pg:status",
    "pg:reset": "npm --workspace server run pg:reset --",
    "db:backup": "npm --workspace server run db:backup --",
    "db:backups": "npm --workspace server run db:backups",
    "db:restore": "npm --workspace server run db:restore --",
    "serve": "npm --workspace server run pg:start && npm --workspace server run start",
    "db:setup": "npm --workspace server run db:setup",
    "db:demo": "npm --workspace server run db:demo",
    "db:fill": "npm --workspace server run db:fill",
    "db:clean": "npm --workspace server run db:clean",
    "verify": "npm --workspace server run verify",
    "predev": "npm --workspace server run pg:start",
    "dev": "concurrently -k -n SERVER,CLIENT -c blue,green \"npm --workspace server run dev\" \"npm --workspace client run dev\"",
    "dev:server": "npm --workspace server run dev",
    "dev:client": "npm --workspace client run dev",
    "build": "npm --workspace server run build && npm --workspace client run build",
    "start": "npm --workspace server run start",
    "db:workers": "npm --workspace server run db:workers"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
