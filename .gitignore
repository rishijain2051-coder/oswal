node_modules/
dist/
build/
*.log

# env
.env
server/.env

# database — the development Postgres cluster lives in the repo but is never committed:
# it is machine-specific binary state, and `npm run pg:start` recreates it from nothing.
server/.pgdata/
# a restore moves the cluster it replaced aside rather than deleting it
server/.pgdata.replaced-*/
server/uploads.replaced-*/
# cold backups of the cluster and uploads (npm run db:backup)
server/backups/

# the SQLite database this project used before Postgres
*.db
*.db-journal
server/prisma/*.db
server/prisma/*.db-journal


# misc
.DS_Store
.vite/
coverage/

# Office temp lock files
~$*

# db backups
*.bak

# TypeScript incremental build info
*.tsbuildinfo
