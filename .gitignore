node_modules/
dist/
build/
*.log

# env
.env
server/.env

# database — the development Postgres cluster lives in the repo but is never committed:
# it is machine-specific binary state, and `npm run pg:start` recreates it from nothing.
server/.pgdata/
# the server log — kept OUT of the data directory, or crash recovery collides with the handle
# pg_ctl holds on it and stalls for half a minute. See the note in scripts/pg.ts.
server/.pglog/
# a restore moves the cluster it replaced aside rather than deleting it
server/.pgdata.replaced-*/
server/uploads.replaced-*/
# cold backups of the cluster and uploads (npm run db:backup)
server/backups/

# Uploaded files — product photos, hand-over proof, worker documents, order attachments.
# The FOLDER is tracked (via .gitkeep) because the app writes into it; its contents are not.
# The demo photos are the ones that catch people out: they are committed once, in
# `prisma/demo/assets/`, and COPIED here by `npm run db:demo` exactly as an upload would be.
# Without this rule every seed leaves a dozen untracked jpegs that look like new work and can
# be re-committed by accident — which is how they ended up in the repo the first time.
server/uploads/*
!server/uploads/.gitkeep

# the SQLite database this project used before Postgres
*.db
*.db-journal
server/prisma/*.db
server/prisma/*.db-journal


# misc
.DS_Store
.vite/
coverage/

# Office temp lock files
~$*

# db backups
*.bak

# TypeScript incremental build info
*.tsbuildinfo
